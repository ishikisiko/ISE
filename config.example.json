{
    "displayResponseTimes": true,
    "LLM_PROVIDER": "opencode-go",
    "orchestrator_mode": "langchain",
    "conversation": {
        "enabled": true,
        "checkpoint_path": "./checkpoints/conversations.sqlite",
        "history_window": 5,
        "max_threads": 200
    },
    "audit": {
        "_comment": "Audit files contain queries and, by default, answers. They are retained under gitignored runtime/audit; set include_answer false or lower max_files for more restrictive handling.",
        "enabled": false,
        "dir": "runtime/audit",
        "include_answer": true,
        "max_files": 200,
        "max_bytes_per_record": 65536
    },
    "orchestration": {
        "_comment": "Shared analysis, bounded evidence plan, ledger, and verification. LLM analysis remains opt-in; insufficient planned evidence returns an explicit result rather than an unsupported factual draft.",
        "enabled": true,
        "enforce_verification": true,
        "llm_analysis": false,
        "query_budget": 3,
        "result_budget": 8,
        "time_budget_ms": 20000,
        "recovery_budget": 1
    },
    "postcheck": {
        "enabled": false,
        "log_verdicts": false,
        "judge": {
            "enabled": true,
            "provider": "opencode-go",
            "model": "deepseek-v4-flash"
        },
        "react_fallback": {
            "enabled": false,
            "max_iterations": 4,
            "engine": "langgraph"
        }
    },
    "reactAgent": {
        "max_iterations": 5,
        "engine": "langgraph",
        "evaluation": {
            "judge_interval": 2,
            "repeat_threshold": 2,
            "no_progress_threshold": 2,
            "tool_error_threshold": 2,
            "new_evidence_min_ratio": 0.1
        }
    },
    "domainClassifier": {
        "provider": "opencode-go",
        "model": "deepseek-v4-flash"
    },
    "routingAndKeywords": {
        "provider": "opencode-go",
        "model": "deepseek-v4-flash"
    },
    "embeddings": {
        "provider": "openai_compatible",
        "model": "qwen3.7-text-embedding",
        "base_url": "https://YOUR_ALIBABA_CLOUD_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
        "api_key": "YOUR_DASHSCOPE_API_KEY_HERE"
    },
    "localRag": {
        "chunk_size": 1000,
        "chunk_overlap": 200
    },
    "GOOGLE_API_KEY": "YOUR_GOOGLE_API_KEY_HERE",
    "GOOGLE_CX": "YOUR_GOOGLE_CUSTOM_SEARCH_ENGINE_ID_HERE",
    "brightDataSearch": {
        "api_token": "YOUR_BRIGHTDATA_API_TOKEN_HERE",
        "zone": "serp_api1",
        "base_url": "https://api.brightdata.com/request",
        "timeout": 20,
        "search_url_template": "https://www.google.com/search?q={query}"
    },
    "braveSearch": {
        "primary_api_key": "YOUR_BRAVE_PRIMARY_API_KEY_HERE",
        "secondary_api_key": "YOUR_BRAVE_SECONDARY_API_KEY_HERE",
        "base_url": "https://api.search.brave.com/res/v1/web/search",
        "timeout": 15,
        "rps": 1,
        "secondary_rps": 1,
        "monthly_limit": 2000,
        "usage_log_path": "runtime/brave_search_usage.jsonl"
    },
    "firecrawlSearch": {
        "api_key": "YOUR_FIRECRAWL_API_KEY_HERE",
        "base_url": "https://api.firecrawl.dev/v2/search",
        "timeout": 30
    },
    "tavilySearch": {
        "api_key": "YOUR_TAVILY_API_KEY_HERE",
        "base_url": "https://api.tavily.com/search",
        "timeout": 20,
        "search_depth": "basic"
    },
    "parallelSearch": {
        "api_key": "YOUR_PARALLEL_API_KEY_HERE",
        "base_url": "https://api.parallel.ai/v1beta/search",
        "timeout": 30,
        "mode": "fast",
        "max_chars_per_result": 1500
    },
    "parellel2": {
        "_comment": "Parallel Extract for selected public URLs. The runtime also accepts the legacy bare API-key string already used by existing config.json files.",
        "api_key": "YOUR_PARALLEL_API_KEY_HERE",
        "base_url": "https://api.parallel.ai/v1/extract",
        "timeout": 45,
        "full_content": false
    },
    "firecrawl2": {
        "_comment": "Firecrawl Scrape fallback for selected public URLs. The runtime also accepts the legacy bare API-key string already used by existing config.json files.",
        "api_key": "YOUR_FIRECRAWL_API_KEY_HERE",
        "base_url": "https://api.firecrawl.dev/v2/scrape",
        "timeout": 45,
        "only_main_content": true,
        "only_clean_content": false
    },
    "FINNHUB_API_KEY": "",
    "SPORTSDB_API_KEY": "",
    "APISPORTS_KEY": "",
    "googleSearch": {
        "lr": "lang_zh-CN|lang_zh-TW|lang_en",
        "safe": "medium",
        "timeout": 15
    },
    "rerank": {
        "enabled": false,
        "provider": "qwen",
        "min_score": 0.0,
        "max_per_domain": 1,
        "providers": {
            "qwen": {
                "api_key": "YOUR_DASHSCOPE_API_KEY_HERE",
                "model": "qwen3-rerank",
                "base_url": "https://dashscope.aliyuncs.com/api/v1/services/rerank",
                "timeout": 15
            }
        }
    },
    "providers": {
        "openai": {
            "api_key": "YOUR_OPENAI_API_KEY_HERE",
            "model": "gpt-3.5-turbo",
            "base_url": "https://api.openai.com/v1"
        },
        "google": {
            "api_key": "YOUR_GOOGLE_API_KEY_HERE",
            "model": "gemini-2.5-flash",
            "base_url": "https://generativelanguage.googleapis.com/v1beta",
            "available_models": [
                "gemini-2.5-flash",
                "gemini-2.5-flash-lite"
            ]
        },
        "hkgai": {
            "api_key": "YOUR_HKGAI_API_KEY_HERE",
            "model": "HKGAI-V1",
            "base_url": "https://oneapi.hkgai.net/v1"
        },
        "opencode-go": {
            "api_key": "YOUR_OPENCODE_GO_API_KEY_HERE",
            "model": "deepseek-v4-flash",
            "base_url": "https://opencode.ai/zen/go/v1",
            "api_style": "openai",
            "available_models": [
                "glm-5.2",
                "glm-5.1",
                "kimi-k2.7-code",
                "kimi-k2.6",
                "mimo-v2.5",
                "mimo-v2.5-pro",
                "minimax-m3",
                "minimax-m2.7",
                "qwen3.7-max",
                "qwen3.7-plus",
                "qwen3.6-plus",
                "deepseek-v4-pro",
                "deepseek-v4-flash"
            ],
            "model_api_styles": {
                "minimax-m3": "anthropic",
                "minimax-m2.7": "anthropic",
                "qwen3.7-max": "anthropic",
                "qwen3.7-plus": "anthropic",
                "qwen3.6-plus": "anthropic"
            }
        },
        "openrouter": {
            "api_key": "YOUR_OPENROUTER_API_KEY_HERE",
            "model": "minimax/minimax-m2:free",
            "base_url": "https://openrouter.ai/api/v1",
            "available_models": [
                "minimax/minimax-m2:free",
                "x-ai/grok-4.1-fast:free",
                "deepseek/deepseek-r1-0528:free"
            ]
        },
        "minimax": {
            "api_key": "YOUR_MINIMAX_API_KEY_HERE",
            "model": "MiniMax-M2",
            "base_url": "https://api.minimaxi.com/anthropic/v1",
            "thinking": {
                "enabled": true,
                "display_in_response": false
            },
            "available_models": [
                "MiniMax-M2"
            ]
        }
    }
}
