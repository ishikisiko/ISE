{
    "displayResponseTimes": true,
    "LLM_PROVIDER": "opencode-go",
    "skills": {
        "_comment": "Runtime skill registry (roadmap M3). Finance, weather, location, transportation, and sports mount independently when available; list names in disabled for an explicit rollback.",
        "enabled": true,
        "disabled": []
    },
    "conversation": {
        "enabled": true,
        "checkpoint_path": "./checkpoints/conversations.sqlite",
        "history_window": 5,
        "max_threads": 200
    },
    "audit": {
        "_comment": "Audit files contain queries and, by default, answers. Set include_full_result true and both limits to 0 for full durable query records; credentials and URL query strings remain redacted.",
        "enabled": false,
        "dir": "runtime/audit",
        "include_answer": true,
        "include_full_result": false,
        "max_files": 200,
        "max_bytes_per_record": 65536
    },
    "server_logging": {
        "_comment": "Set enabled true to persist stdout, stderr, Flask/Werkzeug logs, HTTP access records, and per-request workflow events under a gitignored directory.",
        "enabled": false,
        "dir": "runtime/server",
        "capture_stdio": true,
        "include_request_payload": true,
        "include_response_payload": true
    },
    "orchestration": {
        "_comment": "Deterministic query analysis plus official-domain resolution used by the sole agentic loop and evidence ledger.",
        "enabled": true,
        "official_domain_resolution": {
            "_comment": "Discover -> verify -> cache resolver for entity official domains. The ruling currency is structurally verifiable relations (registry homepage + homepage->repo backlink closure, Wikidata P856 + support, trusted-domain redirects into the candidate, certificate SAN coverage, facade consistency, CT-log domain age); cross-provider search voting is only a weak signal and can never rule official alone. What is cached is the relation graph, not the verdict, so ruling rules can be re-applied offline. Pinned stems (pins) win with top priority; pin_shadow_audit re-verifies pins in the background and surfaces disagreements without ever overriding the pin. Set enabled false to fall back to pins-only (legacy static-map behavior).",
            "enabled": true,
            "min_signals": 2,
            "cache_path": "./runtime/official_domains.sqlite",
            "cache_ttl_days": 30,
            "negative_ttl_hours": 24,
            "max_discovery_searches": 2,
            "max_verification_fetches": 2,
            "structured_sources": ["wikidata", "pypi", "npm", "github"],
            "min_domain_age_days": 180,
            "graph_probes_enabled": true,
            "pin_shadow_audit": true,
            "pin_audit_ttl_days": 7,
            "aggregator_min_stems": 5,
            "aggregator_observation_window_days": 30,
            "agent_discovery": {
                "_comment": "Agent-assisted discovery for entities the deterministic path leaves at candidate/none. The agent only searches/fetches/looks up registries and submits candidate hosts; every graph edge comes from deterministic tool outputs and the ruling stays with the resolver. Triggered only for authority-required queries.",
                "enabled": false,
                "max_iterations": 4
            },
            "never_official": {
                "mode": "extend",
                "domains": ["csdn.net", "zhihu.com", "juejin.cn", "medium.com"]
            },
            "hosting_platforms": {
                "mode": "extend",
                "domains": []
            },
            "non_evidence": {
                "mode": "extend",
                "domains": []
            },
            "pins": {
                "glm": ["zhipu.cn", "bigmodel.cn", "open.bigmodel.cn"],
                "kimi": ["moonshot.cn", "kimi.com", "platform.moonshot.cn"],
                "openai": ["openai.com", "platform.openai.com"],
                "anthropic": ["anthropic.com", "docs.anthropic.com"],
                "claude": ["anthropic.com", "docs.anthropic.com"],
                "gemini": ["gemini.google.com", "ai.google.dev", "deepmind.google"],
                "deepseek": ["deepseek.com", "platform.deepseek.com"],
                "minimax": ["minimaxi.com", "platform.minimaxi.com"],
                "fable": ["fable.ai"],
                "fireworks": ["fireworks.ai", "docs.fireworks.ai"],
                "together": ["together.ai"],
                "langchain": ["langchain.com", "python.langchain.com"],
                "pytorch": ["pytorch.org"],
                "react": ["react.dev"],
                "nextjs": ["nextjs.org", "nextjs.com"]
            }
        },
        "official_page_extraction": {
            "_comment": "Fetch full page content from official/first-party search hits. DirectFetch runs first; Parallel/Firecrawl/Tavily Extract APIs run only when it cannot return usable content. Set enabled false to keep snippet-only evidence.",
            "enabled": true,
            "max_urls": 4,
            "max_chars_per_page": 4000
        },
        "fetch_url": {
            "_comment": "Agent fetch_url acceptance guard. Short JS shells and other thin extracts are rejected so the extractor router can try the next provider.",
            "min_content_chars": 600,
            "max_chars": 8000
        },
        "directFetch": {
            "_comment": "Preferred zero-API-key extractor for selected public pages: plain HTTP GET plus bs4 main-text extraction. Extract APIs are used only after this fetch fails or returns no usable content. No JS rendering.",
            "enabled": true,
            "timeout": 30,
            "max_chars_per_page": 20000
        }
    },
    "termination": {
        "_comment": "Single stop contract for the agentic loop. Deterministic critic and budgets cannot be overridden by the optional semantic judge.",
        "max_iterations": 5,
        "judge_interval": 2,
        "repeat_threshold": 2,
        "no_progress_threshold": 2,
        "tool_error_threshold": 2,
        "new_evidence_min_ratio": 0.1,
        "tool_budgets": {
            "web_search": 3,
            "fetch_url": 3,
            "search_recovery": 2,
            "local_docs": 2
        },
        "judge": {
            "enabled": true,
            "provider": "opencode-go",
            "model": "deepseek-v4-flash"
        }
    },
    "embeddings": {
        "provider": "openai_compatible",
        "model": "qwen3.7-text-embedding",
        "base_url": "https://YOUR_ALIBABA_CLOUD_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
        "api_key": "YOUR_DASHSCOPE_API_KEY_HERE"
    },
    "localRag": {
        "chunk_size": 1000,
        "chunk_overlap": 200
    },
    "GOOGLE_API_KEY": "YOUR_GOOGLE_API_KEY_HERE",
    "GOOGLE_CX": "YOUR_GOOGLE_CUSTOM_SEARCH_ENGINE_ID_HERE",
    "brightDataSearch": {
        "api_token": "YOUR_BRIGHTDATA_API_TOKEN_HERE",
        "zone": "serp_api1",
        "base_url": "https://api.brightdata.com/request",
        "timeout": 20,
        "search_url_template": "https://www.google.com/search?q={query}"
    },
    "braveSearch": {
        "primary_api_key": "YOUR_BRAVE_PRIMARY_API_KEY_HERE",
        "secondary_api_key": "YOUR_BRAVE_SECONDARY_API_KEY_HERE",
        "base_url": "https://api.search.brave.com/res/v1/web/search",
        "timeout": 15,
        "rps": 1,
        "secondary_rps": 1,
        "monthly_limit": 2000,
        "usage_log_path": "runtime/brave_search_usage.jsonl"
    },
    "firecrawlSearch": {
        "api_key": "YOUR_FIRECRAWL_API_KEY_HERE",
        "base_url": "https://api.firecrawl.dev/v2/search",
        "timeout": 30,
        "search_depth": null
    },
    "tavilySearch": {
        "api_key": "YOUR_TAVILY_API_KEY_HERE",
        "base_url": "https://api.tavily.com/search",
        "timeout": 20,
        "search_depth": "basic"
    },
    "parallelSearch": {
        "api_key": "YOUR_PARALLEL_API_KEY_HERE",
        "base_url": "https://api.parallel.ai/v1beta/search",
        "timeout": 30,
        "mode": "fast",
        "max_chars_per_result": 1500
    },
    "parellel2": {
        "_comment": "Parallel Extract for selected public URLs. The runtime also accepts the legacy bare API-key string already used by existing config.json files.",
        "api_key": "YOUR_PARALLEL_API_KEY_HERE",
        "base_url": "https://api.parallel.ai/v1/extract",
        "timeout": 45,
        "full_content": false
    },
    "firecrawl2": {
        "_comment": "Firecrawl Scrape fallback for selected public URLs. The runtime also accepts the legacy bare API-key string already used by existing config.json files.",
        "api_key": "YOUR_FIRECRAWL_API_KEY_HERE",
        "base_url": "https://api.firecrawl.dev/v2/scrape",
        "timeout": 45,
        "only_main_content": true,
        "only_clean_content": false
    },
    "tavily2": {
        "_comment": "Tavily Extract fallback for selected public URLs. The runtime also accepts the legacy bare API-key string already used by existing config.json files.",
        "api_key": "YOUR_TAVILY_API_KEY_HERE",
        "base_url": "https://api.tavily.com/extract",
        "timeout": 45,
        "extract_depth": "basic",
        "format": "markdown"
    },
    "FINNHUB_API_KEY": "",
    "SPORTSDB_API_KEY": "",
    "APISPORTS_KEY": "",
    "googleSearch": {
        "lr": "lang_zh-CN|lang_zh-TW|lang_en",
        "safe": "medium",
        "timeout": 15
    },
    "rerank": {
        "enabled": false,
        "provider": "qwen",
        "min_score": 0.0,
        "max_per_domain": 1,
        "providers": {
            "qwen": {
                "api_key": "YOUR_DASHSCOPE_API_KEY_HERE",
                "model": "qwen3-rerank",
                "base_url": "https://dashscope.aliyuncs.com/api/v1/services/rerank",
                "timeout": 15
            }
        }
    },
    "providers": {
        "openai": {
            "api_key": "YOUR_OPENAI_API_KEY_HERE",
            "model": "gpt-3.5-turbo",
            "base_url": "https://api.openai.com/v1"
        },
        "google": {
            "api_key": "YOUR_GOOGLE_API_KEY_HERE",
            "model": "gemini-2.5-flash",
            "base_url": "https://generativelanguage.googleapis.com/v1beta",
            "available_models": [
                "gemini-2.5-flash",
                "gemini-2.5-flash-lite"
            ]
        },
        "hkgai": {
            "api_key": "YOUR_HKGAI_API_KEY_HERE",
            "model": "HKGAI-V1",
            "base_url": "https://oneapi.hkgai.net/v1"
        },
        "opencode-go": {
            "api_key": "YOUR_OPENCODE_GO_API_KEY_HERE",
            "model": "deepseek-v4-flash",
            "base_url": "https://opencode.ai/zen/go/v1",
            "api_style": "openai",
            "available_models": [
                "glm-5.2",
                "glm-5.1",
                "kimi-k2.7-code",
                "kimi-k2.6",
                "mimo-v2.5",
                "mimo-v2.5-pro",
                "minimax-m3",
                "minimax-m2.7",
                "qwen3.7-max",
                "qwen3.7-plus",
                "qwen3.6-plus",
                "deepseek-v4-pro",
                "deepseek-v4-flash"
            ],
            "model_api_styles": {
                "minimax-m3": "anthropic",
                "minimax-m2.7": "anthropic",
                "qwen3.7-max": "anthropic",
                "qwen3.7-plus": "anthropic",
                "qwen3.6-plus": "anthropic"
            }
        },
        "openrouter": {
            "api_key": "YOUR_OPENROUTER_API_KEY_HERE",
            "model": "minimax/minimax-m2:free",
            "base_url": "https://openrouter.ai/api/v1",
            "available_models": [
                "minimax/minimax-m2:free",
                "x-ai/grok-4.1-fast:free",
                "deepseek/deepseek-r1-0528:free"
            ]
        },
        "minimax": {
            "api_key": "YOUR_MINIMAX_API_KEY_HERE",
            "model": "MiniMax-M2",
            "base_url": "https://api.minimaxi.com/anthropic/v1",
            "thinking": {
                "enabled": true,
                "display_in_response": false
            },
            "available_models": [
                "MiniMax-M2"
            ]
        }
    }
}
